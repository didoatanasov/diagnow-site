# Copy to .dev.vars for `npm run preview` (wrangler dev). Never commit .dev.vars.
# Cloudflare Turnstile test secret: always passes (pairs with site key 1x00000000000000000000AA).
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Log submissions instead of calling Mailchimp.
MAILCHIMP_DRY_RUN=1
# Only needed when MAILCHIMP_DRY_RUN=0:
# MAILCHIMP_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-us6

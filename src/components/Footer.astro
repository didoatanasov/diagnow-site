---
import { copy, localePath, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = copy[lang];
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap row">
    <img src="/logo-dark.svg" alt="diagnow.ai" width="160" height="28" />
    <ul>
      <li><a href={localePath(lang, 'privacy')}>{t.footer.privacy}</a></li>
      <li><a href={`mailto:${t.footer.email}`}>{t.footer.email}</a></li>
    </ul>
  </div>
  <div class="wrap legal">
    <p>© {year} {t.footer.company}</p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--ink-deep);
    color: var(--mist);
    padding-block: 3rem 2.5rem;
    font-size: 1rem;
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  img {
    height: 1.75rem;
    width: auto;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a {
    color: var(--mist);
  }

  a:hover {
    color: var(--mint);
  }

  .legal {
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgb(238 244 242 / 0.15);
    color: rgb(238 244 242 / 0.75);
    font-size: var(--step--1);
  }
</style>

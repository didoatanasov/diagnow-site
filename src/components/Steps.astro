---
import { copy, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const t = copy[Astro.props.lang].how;
---

<section id="how" class="section" aria-labelledby="how-title">
  <div class="wrap">
    <div class="section-head">
      <h2 id="how-title">{t.heading}</h2>
    </div>
    <ol>
      {
        t.steps.map((step) => (
          <li>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  ol {
    counter-reset: step;
    display: grid;
    gap: 2.5rem 2rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 40rem) {
    ol {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 64rem) {
    ol {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  li {
    counter-increment: step;
    position: relative;
    padding-top: 3.25rem;
    border-top: 2px solid var(--ink);
  }

  /* A real sequence, so the numbers carry meaning. */
  li::before {
    content: counter(step);
    position: absolute;
    top: 0.85rem;
    left: 0;
    font-size: var(--step-2);
    font-weight: 600;
    line-height: 1;
    color: var(--teal);
  }

  /* Step 3 is where the doctor decides: the line turns amber to mark the human decision point. */
  li:nth-child(3) {
    border-top-color: var(--amber);
  }

  h3 {
    margin-bottom: 0.6rem;
  }

  p {
    color: var(--muted);
  }
</style>

{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "diagnow-site",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-13",
  "observability": { "enabled": true },

  // Static site built by Astro. Only /api/* runs the Worker first;
  // everything else is served straight from the assets.
  "assets": {
    "directory": "./dist/",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },

  // diagnow.ai serves the site. www.diagnow.ai is redirected to it by a
  // Cloudflare Redirect Rule (see README), because page requests never reach the Worker.
  "routes": [{ "pattern": "diagnow.ai", "custom_domain": true }],

  // Public configuration. Secrets (MAILCHIMP_API_KEY, TURNSTILE_SECRET_KEY)
  // are set with `wrangler secret put` — see README.md.
  "vars": {
    "CANONICAL_HOST": "diagnow.ai",
    "MAILCHIMP_AUDIENCE_ID": "REPLACE_WITH_AUDIENCE_ID",
    "MAILCHIMP_API_BASE": "",
    "MAILCHIMP_DRY_RUN": "0"
  }
}
